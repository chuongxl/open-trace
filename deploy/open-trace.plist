<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.open-trace</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE_PATH}}</string>
    <string>{{PWD}}/daemon/index.js</string>
  </array>
  <key>WorkingDirectory</key><string>{{PWD}}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{{HOME}}/.open-trace/daemon.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/.open-trace/daemon.log</string>
</dict>
</plist>
